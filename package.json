{
  "name": "borrowlab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write client lib server tests docs README.md"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "^1.31.0",
    "mongodb": "7.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
