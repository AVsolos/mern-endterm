{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["api", "client", "lib/domain.ts", "server", "tests", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "outputs"]
}
